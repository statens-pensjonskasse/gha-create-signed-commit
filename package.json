{
    "name": "gha-create-signed-commit",
    "description": "Create a signed commit using the GitHub API without pushing it",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "test": "node --test --import tsx **/*.test.ts",
        "prebuild": "mkdir -p dist",
        "build": "ncc build src/index.ts -o dist --minify",
        "lint": "biome check",
