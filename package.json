    },
    "devDependencies": {
        "@statens-pensjonskasse/biome": "^2.0.23",
        "@types/node": "^24.12.2",
        "@vercel/ncc": "^0.38.4",
        "esmock": "^2.7.3",
        "tsx": "^4.21.0",
        "typescript": "^7.0.2"
    }
}
